{
  "name": "clauddddee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src docs",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "npm install --prefix tools/drizzle --no-audit --no-fund",
    "predb:generate": "npm run db:setup",
    "db:generate": "npm --prefix tools/drizzle exec -- drizzle-kit generate --config drizzle.config.ts",
    "predb:migrate": "npm run db:setup",
    "db:migrate": "npm --prefix tools/drizzle exec -- drizzle-kit migrate --config drizzle.config.ts",
    "predb:studio": "npm run db:setup",
    "db:studio": "npm --prefix tools/drizzle exec -- drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
