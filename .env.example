# Modelo das variáveis de ambiente — copie para `.env.local` e preencha.
# Nunca coloque valores reais neste ficheiro: ele é versionado.
# Detalhes de cada bloco em docs/DEPLOY.md.

# ── Aplicação ────────────────────────────────────────────────────────────
# URL pública do painel. Em produção use sempre https://.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domínio do painel, sem https:// e sem www. (docs/DEPLOY.md, secção 9)
PANEL_HOST=
# Allowlist de donos, separados por vírgula (docs/DEPLOY.md, secção 2.1)
OWNER_EMAILS=
# `true` abre o painel sem login quando o Supabase não está configurado.
# Mantenha vazio em produção.
ALLOW_DEMO_MODE=

# ── Supabase / banco ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (porta 6543) com ?pgbouncer=true
DATABASE_URL=
# Ligação direta (porta 5432), usada pelas migrations
DIRECT_URL=
# 32 bytes em base64: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Pagamentos (Broski) ──────────────────────────────────────────────────
BROSKI_API_KEY=
BROSKI_WEBHOOK_SECRET=

# ── E-mails (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# ── Rate limit (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Tarefas agendadas ────────────────────────────────────────────────────
# Valor aleatório com pelo menos 32 caracteres
CRON_SECRET=

# ── Sincronização Milluni (docs/MILLUNI.md) ──────────────────────────────
MILLUNI_BASE_URL=
MILLUNI_ADMIN_USER=
MILLUNI_ADMIN_PASSWORD=

# ── Publicação de landing pages na Vercel (landing-sites/README.md) ──────
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── Meta Conversions API (opcional) ──────────────────────────────────────
# Versão da Graph API. Deixe comentado para usar a predefinida do código.
# META_GRAPH_API_VERSION=v24.0
